# Lux3D 国内环境 API Key（https://lux3d.aholo3d.cn 申请）。留空则自动进入 mock 模式。
LUX3D_API_KEY=
LUX3D_BASE_URL=https://api.aholo3d.cn
# 置 1 强制 mock（不调用真实接口，用 public/mock/sample.glb 占位）
LUX3D_MOCK=
# 新建/修改商品需要的访问码。留空则任何人都能生成（会消耗你的 Lux3D 积分）
ACCESS_CODE=
# 部署到 Vercel 并连上 Blob 存储后自动注入，本地开发不用填
# BLOB_READ_WRITE_TOKEN=
